{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "kind": {"const": "estimate"},
    "source_type": {"enum": ["user_measurement", "manufacturer_declaration", "derived_estimate", "unknown"]},
    "estimate_readiness": {"enum": ["labeled_runtime_estimate", "calibration_only", "unknown"]},
    "basis_kind": {"enum": ["manufacturer_declared_quantity", "user_measurement_derivation", "documented_method"]},
    "basis_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "confidence": {"enum": ["declared_source_limited", "measurement_derived_limited", "unknown"]},
    "label": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "quantity": {"type": "object", "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["ml/action", "ml/cycle", "ml/m2", "ml/min"]}}, "required": ["value", "unit"], "additionalProperties": false},
    "method": {"type": "string", "minLength": 1},
    "applicability": {"type": "object", "properties": {"model_scope": {"enum": ["named_model"]}, "sku_scope": {"enum": ["unknown", "exact"]}, "firmware_scope": {"enum": ["unknown", "exact"]}}, "required": ["model_scope", "sku_scope", "firmware_scope"], "additionalProperties": false},
    "context": {"type": "object", "properties": {"model_id": {"type": "string"}, "sku": {"type": ["string", "null"]}, "dock_variant": {"type": ["string", "null"]}, "firmware": {"type": ["string", "null"]}, "integration_id": {"type": ["string", "null"]}, "integration_version": {"type": ["string", "null"]}, "reservoir": {"enum": ["dock_clean", "dock_dirty", "robot_clean", "robot_dirty", "detergent"]}, "action": {"type": "string"}, "settings": {"type": "object"}}, "required": ["model_id", "sku", "dock_variant", "firmware", "integration_id", "integration_version", "reservoir", "action", "settings"], "additionalProperties": false},
    "provenance": {"type": "array", "items": {"type": "object", "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "date": {"type": "string", "format": "date"}, "type": {"enum": ["manufacturer", "empirical", "derived", "synthetic"]}, "claim": {"type": "string", "minLength": 1}}, "required": ["url", "date", "type", "claim"], "additionalProperties": false}, "minItems": 1},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["id", "kind", "source_type", "estimate_readiness", "basis_kind", "basis_ids", "confidence", "label", "limitations", "quantity", "method", "applicability", "context", "provenance", "unknowns"],
  "additionalProperties": false
}
