{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_class", "hardware_verified", "sources", "bindings", "settings", "action_completion"],
  "properties": {
    "schema_version": {"const": 2},
    "fixture_class": {"enum": ["source_contract", "synthetic_live_contract_test_only"]},
    "hardware_verified": {"type": "boolean"},
    "verification": {"type": "object"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
    "bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "settings": {"type": "array", "minItems": 13, "items": {"type": "object"}},
    "action_completion": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "object"}}
  }
}
