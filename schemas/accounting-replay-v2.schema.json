{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_class", "source_provenance", "baseline_id", "baseline_observed_at_ms", "device_identity", "initial_reservoirs", "setting_segments", "events", "expected_final_reservoirs"],
  "properties": {
    "schema_version": {"const": 2},
    "fixture_class": {"enum": ["synthetic_accounting_replay", "physical_event_stream", "synthetic_live_event_stream_test_only"]},
    "source_provenance": {"enum": ["synthetic", "physical_ml", "synthetic_physical_ml_test_only"]},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_observed_at_ms": {"type": "integer", "minimum": 0},
    "device_identity": {"type": "object", "additionalProperties": false, "required": ["installation_id", "vacuum_id", "model_id", "sku", "firmware", "integration_id", "integration_version"], "properties": {"installation_id": {"type": "string", "minLength": 1}, "vacuum_id": {"type": "string", "minLength": 1}, "model_id": {"type": ["string", "null"]}, "sku": {"type": ["string", "null"]}, "firmware": {"type": ["string", "null"]}, "integration_id": {"type": "string", "minLength": 1}, "integration_version": {"type": "string", "minLength": 1}}},
    "initial_reservoirs": {"$ref": "#/$defs/reservoirs"},
    "expected_final_reservoirs": {"$ref": "#/$defs/reservoirs"},
    "setting_segments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "start_at_ms", "end_at_ms", "settings_id"], "properties": {"id": {"type": "string"}, "start_at_ms": {"type": "integer", "minimum": 0}, "end_at_ms": {"type": "integer", "minimum": 0}, "settings_id": {"type": "string"}}}},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "sequence", "observed_at_ms", "segment_id", "source_contract_id", "quantity_provenance", "completed", "aborted", "completion_evidence", "edges"], "properties": {"id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1}, "observed_at_ms": {"type": "integer", "minimum": 0}, "segment_id": {"type": "string"}, "source_contract_id": {"type": "string"}, "quantity_provenance": {"enum": ["synthetic", "physical_ml"]}, "completed": {"type": "boolean"}, "aborted": {"type": "boolean"}, "completion_evidence": {"enum": ["counter_increment", "terminal_event", "command", "state", "none"]}, "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "amount_ml"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "amount_ml": {"type": "number", "exclusiveMinimum": 0}}}}}}}
  },
  "$defs": {"reservoirs": {"type": "object", "additionalProperties": false, "required": ["dock_clean", "dock_dirty", "robot_clean", "robot_dirty", "detergent"], "properties": {"dock_clean": {"type": "number", "minimum": 0}, "dock_dirty": {"type": "number", "minimum": 0}, "robot_clean": {"type": "number", "minimum": 0}, "robot_dirty": {"type": "number", "minimum": 0}, "detergent": {"type": "number", "minimum": 0}}}}
}
